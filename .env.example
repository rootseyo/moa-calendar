# Server Configuration
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/share_schedule_db
DEMO_MODE=false

# Google OAuth (Optional: for Google Calendar import & Social Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth (Optional: for Kakao Social Login)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Token Encryption Key
# 32 random bytes encoded as 64 hexadecimal characters; keep secret and backed up.
# Generate with: node scripts/ensure-token-key.mjs
OAUTH_TOKEN_ENCRYPTION_KEY=

# Web Push VAPID keys (generate with: node scripts/ensure-vapid-keys.mjs)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# CalDAV Background Sync interval in milliseconds (default: 15 minutes = 900000)
# CALDAV_SYNC_INTERVAL_MS=900000

# Optional: Analytics Collector Endpoint
# ANALYTICS_ENDPOINT=https://your-analytics-server.com/api/collect
